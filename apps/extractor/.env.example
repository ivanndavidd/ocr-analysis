# Placeholder saja. Nilai asli tidak pernah di-commit; salin ke .env (di-gitignore) atau set di environment.

# OCR lokal: path tesseract bila tidak ada di PATH
TESSERACT_CMD=

# extractor.provider: claude (hanya dipakai bila extractor.enabled: true)
ANTHROPIC_API_KEY=

# extractor.provider: claude-code, path binary Claude Code bila tidak di PATH; login lewat `claude auth login`, bukan di sini
CLAUDE_CODE_CMD=

# extractor.provider: gemini-vertex, autentikasi lewat Application Default Credentials (bukan API key)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
