# line above hid from git until 2026-11-11
!apps/extractor/src/contract_extractor/output/
# Fase 0 labels name real employees: keep them in data/; only the empty label-template.csv is shared
labels*.csv

# Logs and OS noise
*.log
logs/
.DS_Store
Thumbs.db

