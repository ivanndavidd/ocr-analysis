dist/
build/
coverage/
*.tsbuildinfo

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

