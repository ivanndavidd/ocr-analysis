# Placeholder saja. Nilai asli tidak pernah di-commit; salin ke .env (di-gitignore) atau set di environment.

# OCR lokal: path tesseract bila tidak ada di PATH
TESSERACT_CMD=

# extractor.provider: claude (hanya dipakai bila extractor.enabled: true). Diisi: Claude API dengan API key ini.
# Kosong: Claude Code dengan login `claude auth login` pengguna yang menjalankan (uji lokal saja).
ANTHROPIC_API_KEY=

# extractor.provider: claude tanpa API key, atau claude-code: path binary Claude Code bila tidak di PATH
CLAUDE_CODE_CMD=

# extractor.provider: gemini-vertex, autentikasi lewat Application Default Credentials (bukan API key)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
