# Copy to .env and fill in. Bun loads .env automatically.

# Where contracts come from. Fill in the required SHAREPOINT_* settings to read a SharePoint document library
# through Microsoft Graph; leave every SHAREPOINT_* empty to browse FOLDER_ROOT instead. Half a SharePoint setup is
# refused at startup rather than falling back to the local folder.

# Local folder the website may browse (testing: a OneDrive folder with synthetic contracts only).
FOLDER_ROOT=C:/Users/<you>/OneDrive/kontrak-testing

# SharePoint, read with an Entra ID app registration's own access (client credentials). IT creates the app and gives it
# the Microsoft Graph application permission Sites.Selected, then read access on this one site only.
# Entra ID > App registrations > the app > Overview: "Directory (tenant) ID" and "Application (client) ID".
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
# How the app proves who it is: set exactly ONE of the three below. Never commit any of them.
# Preferred, a certificate: its public part (.cer) is uploaded to the app (Certificates & secrets > Certificates) and
# only a signed, ten-minute token request leaves this machine. Give a PEM holding the private key (unencrypted, RSA)
# and the certificate, as a file path for local use, or as text for Vault on AIVA (newlines may be written as \n).
SHAREPOINT_CERTIFICATE_PATH=
SHAREPOINT_CERTIFICATE_PEM=
# Fallback, a client secret: Certificates & secrets > Client secrets > "Value" (shown once).
SHAREPOINT_CLIENT_SECRET=
# The site that holds the contracts, as the browser address bar shows it: https://<company>.sharepoint.com/sites/<site>
SHAREPOINT_SITE_URL=
# Optional: the document library name (empty = the site's default library, "Documents"), and the folder in it the
# website may browse (empty = the whole library), e.g. Kontrak/PKWT.
SHAREPOINT_LIBRARY=
SHAREPOINT_FOLDER=

# Python of the venv where contract-extractor is installed; the backend runs
# "<EXTRACTOR_PYTHON> -m contract_extractor serve-stdio" once per worker.
EXTRACTOR_PYTHON=C:/path/to/.venv/Scripts/python.exe
# Optional extractor YAML config (leave empty for the defaults: LLM step off).
EXTRACTOR_CONFIG=
# true: a file whose every check is green (name and period from the filename confirmed by the document, NIK, signature)
# is decided Otomatis. false or empty: such a file goes to review ("Perlu dicek"), as long as the thresholds are not
# calibrated on real contracts. Overrides decision.allow_auto in EXTRACTOR_CONFIG.
ALLOW_AUTO=
# The local OCR engine that reads every page: rapidocr (Baidu PP-OCRv6 small, on this machine; the default when empty)
# or tesseract. RapidOCR first needs its two model files in RAPIDOCR_MODEL_DIR (below), see AGENTS.md.
OCR_PRIMARY=rapidocr
# true: when the NIK or position the first engine read from a scan is unsure, the other engine (Tesseract when RapidOCR
# reads first) reads the page again; the same value from both turns the cell green, and an agreed NIK is not sent to
# Claude. false or empty: off (the extractor config's ocr.second_reader.enabled). Needs the RapidOCR model files too.
SECOND_READER=
# Folder with PP-OCRv6_det_small.onnx and PP-OCRv6_rec_small.onnx; empty: apps/extractor/models/rapidocr.
RAPIDOCR_MODEL_DIR=
# Tesseract for the extractor, if it is not on PATH.
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Claude helping the patterns (one flow for "Jalankan OCR"): the masked text of the identity page (no NIK, address or
# salary) goes to Claude for the position and the employer, and for the name and period the patterns cannot confirm;
# a crop of only the NIK line, or of the signature area, goes when the local reading of it is unsure. Never a whole
# page. on (default) or off; off sends nothing out.
CLAUDE_MODE=on
# How the workers reach Claude, like SharePoint versus FOLDER_ROOT: set an API key (production, AIVA Vault) to use the
# Claude API; leave it empty to use the Claude Code login of the person running the backend ("claude auth login"),
# which is for local testing only. Never commit a key.
ANTHROPIC_API_KEY=
# Optional: the Claude Code binary, if "claude" is not on PATH (only used without an API key).
CLAUDE_CODE_CMD=
# Model and effort for every file (defaults: claude-haiku-5-5 and max). Effort: low, medium, high, xhigh or max.
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=max

# Users who sign in are recorded in the User table, and every OCR run and its results in OCRHeader and OCRContractDetail
# (names and full NIK in plaintext: synthetic contracts only until envelope encryption is in place). Leave DATABASE_URL empty to keep PostgreSQL inside the backend
# (PGlite, files in DATABASE_DIR, default apps/backend/data/pglite); set it to use a PostgreSQL server, for example
# postgres://<user>:<password>@127.0.0.1:5432/contract_ocr (the database must exist; tables are created on start).
DATABASE_URL=
DATABASE_DIR=

# Users and roles. Whoever signs in for the first time is added as an inactive reviewer and can use nothing until an
# admin activates them on the User page. The emails listed here (comma-separated) become active admins on every
# sign-in: that makes the first admin, and lets an admin who lost access sign in again to get it back. The User
# page cannot change these users; remove an email here to stop it being an admin. Production keeps this in Vault.
ADMIN_EMAILS=

HOST=127.0.0.1
PORT=3000
# Hosts the browser may use to reach the API (the Vite dev server proxies from 5173).
ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000,localhost:5173,127.0.0.1:5173

WORKERS=2
FILE_TIMEOUT_S=120
RECYCLE_AFTER=200
MAX_FILE_MB=50
